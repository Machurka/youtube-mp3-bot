# Скопируй этот файл в .env и впиши свои значения.
# .env в git не попадает — там хранятся секреты.

# Токен бота от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Telegram id администратора(ов) бота, через запятую
ADMIN_IDS=123456789

# Прокси для Telegram API (необязательно)
TG_PROXY=

# Прокси для YouTube (необязательно)
YOUTUBE_PROXY=
